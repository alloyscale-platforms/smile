# Copy this file to .env and fill in real values.
# DATABASE_URL: Postgres connection string. For local dev, `docker compose up -d`
# starts a local Postgres matching this default. For a real deploy, use your
# hosted Postgres connection string instead (Prisma Postgres, Neon, Supabase, etc).
DATABASE_URL="postgresql://smile:smile@localhost:5432/smile"

# Signs session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Only used by `npm run db:seed`. Required (no fallback) when NODE_ENV=production,
# so a real deploy can never accidentally seed the well-known local dev password.
# Leave unset for local dev — the seed script falls back to admin@smile.local /
# smile-admin-123 and also seeds demo helper/requester accounts (skipped in production).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: leave unset to skip email notifications (they log as SKIPPED instead).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Smile <no-reply@example.org>"

# Optional: leave unset to skip real Viber notifications (they log as SKIPPED
# with the payload that would have been sent, so you can verify the shape
# before a bot exists). Fill these in once you register a Viber Public
# Account / Bot: https://developers.viber.com/docs/api/rest-bot-api/
VIBER_BOT_TOKEN=
VIBER_GROUP_ID=
